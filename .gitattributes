# Los archivos que se ejecutan o se leen en el servidor Linux deben tener saltos de línea LF.
*.sh            text eol=lf
deploy/**       text eol=lf
gunicorn.conf.py text eol=lf
*.py            text eol=lf
.github/**       text eol=lf
docs/**         text eol=lf

# Imágenes: nunca convertir saltos de línea
*.jpg binary
*.jpeg binary
*.png binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.dump binary
*.joblib binary
