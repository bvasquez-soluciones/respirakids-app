# Entorno: development | testing | production
RESPIRAKIDS_ENV=development

# Obligatorio en producción (mínimo 32 caracteres). Generar con:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# PostgreSQL
DATABASE_URL=postgresql://usuario:password@localhost:5432/respirakids_db
# Base de datos para pruebas automatizadas (opcional; por defecto SQLite en memoria)
TEST_DATABASE_URL=

# Asistente IA (Google Gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Machine Learning complementario: modelo EXPERIMENTAL entrenado con datos sintéticos (ver ml/MODELO_ML.md).
# Solo lo ven los profesionales y nunca cambia la clasificación por reglas. En producción está apagado por defecto.
# Reentrenar: flask ml generar-dataset && flask ml entrenar
ML_HABILITADO=true

# Almacenamiento del límite de peticiones. En producción con varios workers usar Redis:
#   RATELIMIT_STORAGE_URI=redis://localhost:6379/0
RATELIMIT_STORAGE_URI=memory://

LOG_LEVEL=INFO

# Correo saliente (recuperación de contraseña y verificación de correo). Obligatorio en producción.
# En desarrollo, si MAIL_SERVER está vacío, los correos se escriben en el log en lugar de enviarse.
MAIL_SERVER=
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=RespiraKids <no-responder@tu-dominio.co>

# Responsable del tratamiento de datos (Ley 1581 de 2012). Aparecen en la política de privacidad.
RESPONSABLE_NOMBRE=
RESPONSABLE_ID=
RESPONSABLE_DIRECCION=
RESPONSABLE_CORREO=
RESPONSABLE_TELEFONO=

# Motor clínico: v1-aiepi (Herramienta Clínica MinSalud) o v0-provisional.
MOTOR_CLINICO_VERSION=v1-aiepi
# Solo en producción: versión de reglas validada y firmada por un profesional de salud.
REGLAS_CLINICAS_VALIDADAS=
